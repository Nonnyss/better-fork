            7c4228f4f1cd9e47 t("─ budget ──────────────────────────────────────────",JetBrains Mono,14,r,align(l),lh(1.25)) mref(28f611c095278aa0) ov[textData,vectorPath] p(0,0.25) s(hug:428.4,hug:17.5) f[(16630ccb0bbd0b7d,tok(color.tree.guide,#43434A))] $typography.row "Rule text"
              spans[(2,8,$color.tree.dim)]
        b10e6e3de37f325c t("1 watch, not poll: fs.watch on jobs/ and sessions/, debounced 150 ms; reread only the file that changed.",JetBrains Mono,14,r,align(l),lh(1.25)) p(8,170) s(fill,hug:52.5) ext(404,) f[(c1038796b38070eb,tok(color.text.secondary,#C5C5C9))] $typography.row "Text 328"
          spans[(0,1,$color.opening)]
        8365b954e57df6e9 t("2 one timer, on the drawing thread, alive only while a working row is visible. No $ round trip per frame.",JetBrains Mono,14,r,align(l),lh(1.25)) p(8,222.5) s(fill,hug:52.5) ext(404,) f[(6aedd023925bff2c,tok(color.text.secondary,#C5C5C9))] $typography.row "Text 329"
          spans[(0,1,$color.opening)]
        8849b4f7a3afee51 t("3 a frame swaps one cell per working row; rows are memoised, the tree is not rebuilt.",JetBrains Mono,14,r,align(l),lh(1.25)) p(8,275) s(fill,hug:35) ext(404,) f[(f677c67bfafa9771,tok(color.text.secondary,#C5C5C9))] $typography.row "Text 330"
          spans[(0,1,$color.opening)]
        4fee29cca1227d9c t("4 detached or hidden pane: timer and watchers stop.",JetBrains Mono,14,r,align(l),lh(1.25)) p(8,310) s(fill,hug:35) ext(404,) f[(b80a34d46b99c2b5,tok(color.text.secondary,#C5C5C9))] $typography.row "Text 331"
          spans[(0,1,$color.opening)]
